<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIRPG.Features.Brewery.Editors.World"
             xmlns:main_vm="using:AIRPG.Features.Brewery.Editors"
             x:Class="AIRPG.Features.Brewery.Editors.WorldEditorView"
             x:DataType="main_vm:WorldEditorViewModel">

<UserControl.DataTemplates>
        <DataTemplate DataType="vm:WorldCreateViewModel">
            <Grid RowDefinitions="2*,*">
                <TextBox Grid.Row="0" Text="{Binding WorldText}"
                        TextWrapping="Wrap" AcceptsReturn="True"
                        Watermark="{Binding WorldTextWatermark}"/>
                <TextBox Grid.Row="1" Text="{Binding UserPrompt}"
                        TextWrapping="Wrap" AcceptsReturn="True"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="vm:WorldLoreViewModel">
            <TextBlock>Lore</TextBlock>
        </DataTemplate>

        <DataTemplate DataType="vm:WorldAbstractViewModel">
            <TextBlock>Abstract</TextBlock>
        </DataTemplate>

        <DataTemplate DataType="vm:WorldMapViewModel">
            <TextBlock>Map</TextBlock>
        </DataTemplate>

</UserControl.DataTemplates>
             
<ContentControl Content="{Binding Workspace}"/>

</UserControl>