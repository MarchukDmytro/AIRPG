<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:AIRPG.Features.Brewery.Editors.Items"
            xmlns:main_vm="using:AIRPG.Features.Brewery.Editors"
            x:Class="AIRPG.Features.Brewery.Editors.ItemEditorView"
            x:DataType="main_vm:ItemEditorViewModel">

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:ItemCreateViewModel">

            <Grid ColumnDefinitions="*,3*">
                <Border BorderThickness="3" BorderBrush="Black">
                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" >
                <!-- Image -->      
                    <Border Grid.Row="0" BorderBrush="Black" BorderThickness="1" Height="{Binding $self.Bounds.Width}">
                        <TextBlock  Text="Img" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                <!-- Name under img -->
                    <TextBox Grid.Row="1" Text="{Binding Name}" Watermark="Name" TextAlignment="Center" BorderThickness="3" BorderBrush="Black"  HorizontalAlignment="Stretch" Background="Transparent" />
                <!-- Properties -->
                    <Border Grid.Row="2" BorderBrush="Black" BorderThickness="1" Padding="5">
                    <!-- Properties -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="5" >
                        <!-- Row 0: Value -->
                            <Label Grid.Row="0" Grid.Column="0" Content="Value: " VerticalAlignment="Center"/>
                            <NumericUpDown  Grid.Row="0" Grid.Column="1" Margin="0,2" ShowButtonSpinner="False"  Minimum="0"/>

                        <!-- Row 1: Weight -->
                            <Label Grid.Row="1" Grid.Column="0" Content="Weight: " VerticalAlignment="Center"/>
                            <NumericUpDown  Grid.Row="1" Grid.Column="1" Margin="0,2" ShowButtonSpinner="False"  Minimum="0"/>

                        <!-- Row 2: Type -->
                            <Label Grid.Row="2" Grid.Column="0" Content="Type: " VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,2"
                            ItemsSource ="{Binding AllItemTypes}" PlaceholderText="None" SelectedItem="{Binding Type}"/>
                        <!-- Row 3 Secondary Properties -->
                            <ScrollViewer  Grid.Row="3" Grid.ColumnSpan="2">
                                <ItemsControl  ItemsSource="{Binding SecondaryProperties}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>


                                    <ItemsControl.DataTemplates>
                                        <!-- IF INT -->
                                        <DataTemplate DataType="vm:IntPropertyVM">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Label Grid.Column="0" Content="{Binding Name, StringFormat='{}{0}: '}"/>  
                                                <NumericUpDown Grid.Column="1" Value="{Binding Property, Converter={StaticResource FloorIntConverter}}" 
                                                FormatString="{}{0:F0}"  Margin="0,2" ShowButtonSpinner="False"  Minimum="0"/>  
                                            </Grid>
                                        </DataTemplate>    
                                        <!-- IF DOUBLE -->
                                        <DataTemplate DataType="vm:DoublePropertyVM">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Label Grid.Column="0" Content="{Binding Name, StringFormat='{}{0}: '}"/>  
                                                <NumericUpDown Grid.Column="1" Value="{Binding Property}" 
                                                Margin="0,2" ShowButtonSpinner="False"  Minimum="0"/>  
                                            </Grid>
                                        </DataTemplate>    
                                        <!-- If BOOL  -->
                                        <DataTemplate DataType="vm:BoolPropertyVM">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Label Grid.Column="0" Content="{Binding Name, StringFormat='{}{0}: '}"/>  
                                                <CheckBox Grid.Column="1" IsChecked="{Binding Property}"></CheckBox>
                                            </Grid>
                                        </DataTemplate>   
                                        <!-- If Enum -->
                                        <DataTemplate DataType="vm:EnumPropertyVM">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Label Grid.Column="0" Content="{Binding Name, StringFormat='{}{0}: '}"/>  
                                                <ComboBox  Grid.Column="1" ItemsSource="{Binding Options}" PlaceholderText="None" SelectedItem="{Binding Property}"/>
                                            </Grid>
                                        </DataTemplate> 
                                        <!-- Flaged Enum -->
                                        <DataTemplate DataType="vm:EnumMultiplePropertiesVM">
                                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                                    <Label Grid.Column="0" Grid.Row="0" Content="{Binding Name, StringFormat='{}{0}: '}"/>  
                                                    <Button Content="+" Grid.Column="1" Grid.Row="0">
                                                        <Button.Flyout>
                                                            <Flyout>
                                                                <Border>
                                                                    <ItemsControl ItemsSource="{Binding Options}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <UniformGrid Columns="3"/>
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.DataTemplates>
                                                                            <DataTemplate DataType="vm:PropertyOptionVM">
                                                                                <Grid ColumnDefinitions="Auto,*">
                                                                                    <Label Grid.Column="0" Content="{Binding Property, StringFormat='{}{0}: '}"/>  
                                                                                    <CheckBox  Grid.Column="1" IsChecked="{Binding IsObtained}"></CheckBox>
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.DataTemplates>
                                                                    </ItemsControl>
                                                                </Border>    
                                                            </Flyout>
                                                        </Button.Flyout>    
                                                    </Button>
                                                
                                                    <ItemsControl Grid.ColumnSpan="2" Grid.Row="1" ItemsSource="{Binding Options}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.DataTemplates>
                                                            <DataTemplate DataType="vm:PropertyOptionVM">
                                                                <Label Content="{Binding Property}" IsVisible="{Binding IsObtained}" />
                                                            </DataTemplate>
                                                        </ItemsControl.DataTemplates>
                                                    </ItemsControl>
                                                </Grid>
                                        </DataTemplate>
                                        <!-- Damage template -->
                                        <DataTemplate DataType="vm:DamagePropertyVM">
                                            <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto">
                                                <Label Grid.Column="0" Grid.Row="0" Content="Damage: "/>  
                                                <Button Grid.Column="1" Grid.Row="0" Content="+" Command="{Binding AddDamageInstanceCommand}"/>
                                                <ItemsControl Grid.Row="1" Grid.ColumnSpan="3" ItemsSource="{Binding DamageInstances}">
                                                    <ItemsControl.DataTemplates>
                                                        <DataTemplate DataType="vm:DamageInstance">
                                                            <StackPanel>
                                                                <Grid ColumnDefinitions="Auto,Auto,Auto">
                                                                    <NumericUpDown Grid.Column="0" VerticalAlignment="Center" Value="{Binding DiceAmount, Converter={StaticResource FloorIntConverter}}"
                                                                    FormatString="{}{0:F0}"  ShowButtonSpinner="False"   Margin="0,2"  Minimum="0"/>
                                                                    <ComboBox Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding DiceOptions}" PlaceholderText="None" SelectedItem="{Binding Die}"/>
                                                                    <NumericUpDown Grid.Column="2" VerticalAlignment="Center" Value="{Binding FlatDamage, Converter={StaticResource FloorIntConverter}}"
                                                                    FormatString="{}{0:+#;-#;0}" ShowButtonSpinner="False"   Margin="0,2"  Minimum="0"/>
                                                                </Grid>
                                                                <Grid ColumnDefinitions="Auto,*">
                                                                    <Label Grid.Column="0" Grid.Row="1" Content="Damage Type: "/>  
                                                                    <ComboBox Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1" ItemsSource="{Binding DamageTypes}" PlaceholderText="None" SelectedItem="{Binding TypeOfDamage}"/>
                                                                </Grid>
                                                            </StackPanel>

                                                        </DataTemplate>
                                                    </ItemsControl.DataTemplates>
                                                </ItemsControl>
                                            </Grid>
                                        </DataTemplate>   

                                    </ItemsControl.DataTemplates>
                                </ItemsControl>
                            </ScrollViewer>
                            <!-- Row 4 Sourse -->
                            <Label Grid.Row="4" Grid.Column="0" Content="Source: " VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Source}" Grid.Row="4"  Grid.Column="1" AcceptsReturn="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" TextWrapping="Wrap"/>
                        </Grid>
                </Border>
            </Grid>
                </Border>
<!-- Description -->
                <Border Grid.Column="1" BorderBrush="Black" BorderThickness="3">
                    <TextBox Text="{Binding Description}" AcceptsReturn="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" TextWrapping="Wrap"/>
                </Border>

            </Grid>            
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl Content="{Binding Workspace}"/>

</UserControl>